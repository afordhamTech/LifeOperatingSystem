# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_SUPABASE_URL=        # Supabase project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_PUBLISHABLE_KEY=  # Supabase publishable key from the dashboard

# ── Backend / shared auth config ────────────────────────────────
SUPABASE_URL=             # Optional server-side alias for the same Supabase project URL
SUPABASE_ANON_KEY=        # Optional server-side alias for the same publishable/anon key

# ── Admin Role ──────────────────────────────────────────────────
OWNER_SUPABASE_USER_ID=    # Supabase auth user id for the app creator; this user gets role "admin" on first login
